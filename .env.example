# Copy this file to ".env" (git-ignored) and fill in the real values.
# Loaded into your shell before running `npm run deploy`. Never commit .env.
#
# On Windows PowerShell you can load these manually, e.g.:
#   $env:FTP_USER = 'your-ftp-user'; $env:FTP_PASSWORD = 'your-ftp-password'

FTP_USER=REPLACE_ME
FTP_PASSWORD=REPLACE_ME
# Optional; defaults to ftp.infogoer.com
FTP_HOST=ftp.infogoer.com
